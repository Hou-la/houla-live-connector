{
  "name": "@houla/live-connector",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Receive Hou.la live events (gifts, hearts, chat and more) in real time and wire them into anything: OBS overlays, games, lights, bots.",
  "keywords": [
    "houla",
    "live",
    "stream",
    "gifts",
    "websocket",
    "events",
    "overlay",
    "obs"
  ],
  "license": "MIT",
  "author": "Hou.la",
  "homepage": "https://github.com/Hou-la/houla-live-connector",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hou-la/houla-live-connector.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "houla-connector": "bin/houla-connector.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "build:exe": "npm run build && pkg bin/houla-connector.js --targets node18-win-x64 --output release/houla-connector.exe"
  },
  "pkg": {
    "scripts": [
      "dist/**/*.js"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "socket.io-client": "^4.7.5"
  },
  "optionalDependencies": {
    "rcon-client": "^4.2.4"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "@yao-pkg/pkg": "^6.3.0"
  }
}
